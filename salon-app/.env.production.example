# ─────────────────────────────────────────────────────────────
# PRODUCTION ENV — salon-app (Netlify)
# Set these in Netlify: Site settings > Environment variables.
# Vite inlines them at BUILD time, so redeploy after changing them.
# ─────────────────────────────────────────────────────────────

# The full URL of your deployed backend (Railway/Render). No trailing slash.
# The app appends /api automatically.
VITE_API_URL=https://your-backend.up.railway.app

# OAuth (optional) — only if you enable social sign-in.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=your-facebook-app-id
