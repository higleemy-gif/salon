# Backend API base URL.
# - Local dev: leave this unset — Vite proxies /api to http://localhost:4000 (see vite.config.js).
# - Production (Netlify): set this to your deployed backend URL, e.g.
#   VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=http://localhost:4000

# OAuth (optional) — only needed if you enable Google / Facebook sign-in.
# Get these from Google Cloud Console and the Facebook Developer Portal.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=your-facebook-app-id
