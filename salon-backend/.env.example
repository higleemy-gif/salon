# ── Database ──
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/glowdesk?schema=public"

# ── JWT ──
JWT_SECRET="generate-a-strong-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ── Server ──
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# ── OAuth (Google) ──
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ── OAuth (Facebook) ──
FACEBOOK_APP_ID="your-facebook-app-id"

# ── Seed passwords (used by prisma/seed.js) ──
# Unset values fall back to simple dev defaults; in production they are randomised.
# SEED_OWNER_EMAIL="kiran@orrenza.salon"
# SEED_OWNER_PASSWORD=""
# SEED_ADMIN_PASSWORD=""
# SEED_STYLIST_PASSWORD=""
# SEED_RECEPTIONIST_PASSWORD=""

# ── WhatsApp CRM (optional, see DEPLOYMENT.md) ──
# WACRM_URL="http://localhost:3000"
# WACRM_API_KEY=""
