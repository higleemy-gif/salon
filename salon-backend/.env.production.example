# ─────────────────────────────────────────────────────────────
# PRODUCTION ENV — salon-backend (Railway / Render)
# Copy these keys into your host's "Variables" / "Environment" panel.
# Do NOT commit the filled-in version to git.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase) ──
# Supabase Dashboard > Project Settings > Database > Connection string.
# Use the "Session pooler" string (host looks like aws-0-<region>.pooler.supabase.com,
# port 5432). It is IPv4-friendly and works for both the running server AND
# `prisma migrate deploy`. Replace [PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.<project-ref>:[PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── JWT ──
# Generate a strong secret (>=32 chars), e.g.:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# ── Server ──
NODE_ENV="production"
PORT=4000
# The exact URL of your deployed frontend (Netlify). Used for CORS + message links.
FRONTEND_URL="https://your-salon.netlify.app"

# ── Email / OTP (optional for day-one billing) ──
# Only needed if the client will self-register new staff accounts through the UI.
# Without this, use the seeded owner login instead (see DEPLOYMENT.md).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="\"Your Salon\" <your-email@gmail.com>"

# ── OAuth (optional) ──
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# FACEBOOK_APP_ID="your-facebook-app-id"

# Extra allowed browser origins (comma-separated), in addition to FRONTEND_URL.
# CORS_ORIGINS="https://www.your-salon.com"

# ── WhatsApp session storage ──
# Mount a persistent volume here so the session survives redeploys.
WHATSAPP_AUTH_DIR="/data/whatsapp-auth"

# ── Database creation (optional) ──
# Superuser connection used only if the database in DATABASE_URL doesn't exist yet.
# Leave unset when the database already exists (the normal case on Coolify).
# DB_ADMIN_URL="postgresql://postgres:<password>@<host>:5432/postgres"

# ── Seed passwords — set these BEFORE the first start, then change in-app ──
# Any password left unset gets a random value, printed once in the seed logs.
SEED_OWNER_EMAIL="owner@your-salon.com"
SEED_OWNER_PASSWORD="choose-a-strong-owner-password"
SEED_ADMIN_PASSWORD="choose-a-strong-admin-password"
SEED_STYLIST_PASSWORD="choose-a-strong-stylist-password"
SEED_RECEPTIONIST_PASSWORD="choose-a-strong-receptionist-password"

# ── WhatsApp CRM (whatsapp-crm/) — optional ──
# Lets the billing dashboard send bills on WhatsApp through the CRM's public API.
# WACRM_URL: URL the backend calls (public https URL or internal Coolify URL).
# WACRM_PUBLIC_URL: URL the dashboard links to (defaults to WACRM_URL).
# WACRM_API_KEY: CRM → Settings → API keys, scopes contacts:write + messages:send.
# WACRM_URL="https://crm.your-salon.com"
# WACRM_PUBLIC_URL="https://crm.your-salon.com"
# WACRM_API_KEY="wacrm_live_..."
